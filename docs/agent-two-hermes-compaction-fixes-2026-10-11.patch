index 0000000000..4e7f8bbb49
--- /dev/null
+++ b/tests/agent/test_workspace_pin_aliases.py
@@ -0,0 +1,33 @@
+"""Directory aliases must not invalidate the workspace snapshot during compaction."""
+
+from types import SimpleNamespace
+
+import pytest
+
+from agent import system_prompt
+from agent.coding_context import WORKSPACE_BLOCK_HEADER
+
+
+@pytest.mark.platforms("posix")
+def test_workspace_pin_key_is_identical_for_a_directory_and_its_alias(tmp_path, monkeypatch):
+    root = tmp_path / "project"
+    root.mkdir()
+    alias = tmp_path / "alias"
+    alias.symlink_to(root, target_is_directory=True)
+    monkeypatch.setattr(system_prompt, "resolve_context_cwd", lambda: root)
+    original = system_prompt._workspace_pin_key()
+    monkeypatch.setattr(system_prompt, "resolve_context_cwd", lambda: alias)
+    assert system_prompt._workspace_pin_key() == original
+
+
+@pytest.mark.platforms("posix")
+def test_persisted_workspace_pin_replays_bytes_from_an_aliased_cwd(tmp_path):
+    root = tmp_path / "project"
+    root.mkdir()
+    alias = tmp_path / "alias"
+    alias.symlink_to(root, target_is_directory=True)
+    block = f"{WORKSPACE_BLOCK_HEADER}\n- Root: {root.resolve()}\n- Status: frozen before work"
+    prompt = f"User home directory: {tmp_path}\nCurrent working directory: {alias}\n\n{block}\n\nremaining prompt"
+    agent = SimpleNamespace(_cached_system_prompt=prompt, _frozen_workspace_snapshot=None)
+    system_prompt._seed_workspace_pin(agent, str(root.resolve()))
+    assert agent._frozen_workspace_snapshot == (str(root.resolve()), block)
