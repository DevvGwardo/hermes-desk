diff --git a/tests/hermes_state/test_compaction_demoted_tail_recall.py b/tests/hermes_state/test_compaction_demoted_tail_recall.py
new file mode 100644
index 0000000000..0857ba3929
--- /dev/null
+++ b/tests/hermes_state/test_compaction_demoted_tail_recall.py
@@ -0,0 +1,88 @@
+"""A shortened carried tool result is not a verbatim duplicate of its original."""
+
+import json
+
+import pytest
+
+import agent.conversation_loop  # Bootstrap before the test's real-home I/O guard is installed.
+from hermes_state import SessionDB
+from tools.session_search_tool import session_search
+
+
+@pytest.mark.parametrize("named_coverage", [False, True])
+@pytest.mark.parametrize("shortened", [False, True])
+def test_carried_tool_original_is_recallable_only_when_shortened(tmp_path, named_coverage, shortened):
+    db = SessionDB(tmp_path / "state.db")
+    try:
+        sid = "compaction-recall"
+        db.create_session(sid, source="cli")
+        db.append_message(sid, role="user", content="Investigate the test failure")
+        db.append_message(
+            sid, role="assistant", content="",
+            tool_calls=[{"id": "read-1", "type": "function",
+                         "function": {"name": "read_file", "arguments": "{}"}}],
+        )
+        original = db.append_message(
+            sid, role="tool", tool_call_id="read-1", tool_name="read_file",
+            content="diagnosticneedle: the failing assertion requires a preserved receipt",
+        )
+        held = db.get_messages_as_conversation(sid, include_row_ids=True)
+        tail = [dict(message) for message in held[-2:]]
+        if shortened:
+            tail[-1]["content"] = "[read_file] read the test receipt"
+        kwargs = {"covered_ids": [row["id"] for row in db.get_messages(sid)]} if named_coverage else {}
+        db.archive_and_compact(
+            sid, [{"role": "user", "content": "[CONTEXT COMPACTION] investigate the failure"}, *tail],
+            watermark=db.get_active_message_watermark(sid), tail_count=2, **kwargs,
+        )
+
+        archived = next(row for row in db.get_messages(sid, include_inactive=True) if row["id"] == original)
+        assert archived["active"] == 0
+        assert archived["compacted"] == int(shortened)
+        assert archived["content"].startswith("diagnosticneedle:")
+        assert len(db.get_messages(sid)) == 3
+        hits = db.search_messages(query="diagnosticneedle", role_filter=["tool"])
+        assert len(hits) == 1
+        assert hits[0]["id"] == original if shortened else hits[0]["id"] != original
+        if shortened:
+            recalled = json.loads(session_search(
+                query="diagnosticneedle", role_filter="tool", db=db, current_session_id=sid,
+            ))
+            assert recalled["success"] is True
+            assert recalled["count"] == 1
+            anchor = recalled["results"][0]["match_message_id"]
+            scrolled = json.loads(session_search(
+                session_id=sid, around_message_id=anchor, db=db, current_session_id=sid,
+            ))
+            assert scrolled["success"] is True
+            assert any("diagnosticneedle:" in (row["content"] or "") for row in scrolled["messages"])
+    finally:
+        db.close()
+
+
+@pytest.mark.parametrize("named_coverage", [False, True])
+def test_concurrent_tool_clone_stays_hidden_when_call_id_is_reused(tmp_path, named_coverage):
+    db = SessionDB(tmp_path / "state.db")
+    try:
+        sid = "concurrent-tool"
+        db.create_session(sid, source="cli")
+        db.append_message(sid, role="user", content="held request")
+        db.append_message(sid, role="tool", tool_call_id="reused-call", content="held evidence")
+        held = db.get_messages_as_conversation(sid, include_row_ids=True)
+        watermark = db.get_active_message_watermark(sid)
+        concurrent = db.append_message(
+            sid, role="tool", tool_call_id="reused-call", content="concurrentneedle untouched",
+        )
+        tail = dict(held[-1], content="[held output shortened]")
+        kwargs = {"covered_ids": [message["_row_id"] for message in held]} if named_coverage else {}
+        db.archive_and_compact(
+            sid, [{"role": "user", "content": "summary"}, tail],
+            watermark=watermark, tail_count=1, **kwargs,
+        )
+        original = next(row for row in db.get_messages(sid, include_inactive=True) if row["id"] == concurrent)
+        assert (original["active"], original["compacted"]) == (0, 0)
+        hits = db.search_messages(query="concurrentneedle", role_filter=["tool"])
+        assert len(hits) == 1
+        assert hits[0]["id"] != concurrent
+    finally:
+        db.close()
diff --git a/tests/agent/test_compaction_recovery_pointer.py b/tests/agent/test_compaction_recovery_pointer.py
new file mode 100644
index 0000000000..f9ac854da3
--- /dev/null
+++ b/tests/agent/test_compaction_recovery_pointer.py
@@ -0,0 +1,25 @@
+"""Compaction handoffs must recommend discovery, not a query-ignoring read."""
+
+import ast
+import inspect
+import re
+
+from agent.context_compressor import _build_recovery_footer, _lean_recovery_stub
+from tools.session_search_tool import session_search
+
+
+def test_recovery_pointers_search_tool_content_instead_of_reading_active_tail():
+    for pointer in (
+        _build_recovery_footer("session-1", 12),
+        _lean_recovery_stub("read_file", 5000, "session-1"),
+    ):
+        calls = []
+        for arguments in re.findall(r"session_search\(([^)]*)\)", pointer):
+            call = ast.parse("session_search(" + arguments.replace("<match_message_id>", "1") + ")").body[0].value
+            kwargs = {keyword.arg: ast.literal_eval(keyword.value) for keyword in call.keywords}
+            inspect.signature(session_search).bind(**kwargs)
+            calls.append(kwargs)
+        discovery, scroll = calls
+        assert discovery["role_filter"] == "user,assistant,tool"
+        assert "query" in discovery and "session_id" not in discovery
+        assert scroll == {"session_id": "session-1", "around_message_id": 1}
