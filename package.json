{
  "name": "hermes-desk",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b && tsc -p tsconfig.electron.json",
    "check:node": "node scripts/check-node-syntax.mjs",
    "lint": "npm run typecheck && npm run check:node",
    "lint:advisory": "eslint electron/ src/",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:electron": "vitest run --project electron",
    "test:e2e": "vitest run --config tests/e2e/vitest.config.mjs",
    "test:rooms": "node tests/e2e/local-rooms.mjs",
    "test:genui": "node tests/e2e/genui.mjs",
    "test:runtime": "node tests/e2e/runtime-console.mjs",
    "test:runtime:dev": "node tests/e2e/runtime-console.mjs --development-react",
    "test:timezone": "node tests/e2e/timezone-setting.mjs",
    "test:hover": "node tests/e2e/message-hover.mjs",
    "test:bundle": "vitest run --project unit src/lib/__tests__/bundle-budget.test.ts",
    "test:coverage": "vitest run --project unit --coverage",
    "electron:dev": "node scripts/launch-desktop.mjs",
    "electron:build": "node scripts/build-desktop.mjs",
    "electron:package": "node scripts/package-release.mjs",
    "package:release": "node scripts/package-release.mjs",
    "workbench": "open workbench/app/gallery.html && node workbench/app/capture-app.cjs",
    "dev:local": "node scripts/launch-desktop.mjs",
    "install:local": "npm run electron:build && node scripts/install-local.mjs",
    "test:attachments": "node tests/e2e/attachments-lifetime.mjs",
    "test:media:packaged": "node tests/e2e/packaged-media.mjs",
    "test:composer": "node tests/e2e/composer-typing.mjs",
    "test:files-timeout": "node tests/e2e/files-root-timeout.mjs",
    "test:home": "node tests/e2e/home-page.mjs",
    "test:layout": "node tests/e2e/layout-alignment.mjs",
    "test:mascot-stage": "node tests/e2e/mascot-stage.mjs",
    "test:modals": "node tests/e2e/modal-keyboard-layers.mjs",
    "test:a11y": "node tests/e2e/redesign-accessibility.mjs",
    "test:reply-fanout": "node tests/e2e/reply-fanout.mjs",
    "test:reply-recovery": "node tests/e2e/reply-recovery.mjs",
    "test:reply-timeout": "node tests/e2e/reply-timeout.mjs",
    "test:routine": "node tests/e2e/routine-run-lifetime.mjs",
    "test:secrets": "node tests/e2e/secrets-lifetime.mjs",
    "test:sidebar": "node tests/e2e/sidebar-compact.mjs",
    "test:transcript-scroll": "node tests/e2e/transcript-scroll-lifetime.mjs",
    "test:all-e2e": "node tests/e2e/attachments-lifetime.mjs && node tests/e2e/composer-typing.mjs && node tests/e2e/files-root-timeout.mjs && node tests/e2e/home-page.mjs && node tests/e2e/layout-alignment.mjs && node tests/e2e/mascot-stage.mjs && node tests/e2e/modal-keyboard-layers.mjs && node tests/e2e/redesign-accessibility.mjs && node tests/e2e/reply-fanout.mjs && node tests/e2e/reply-recovery.mjs && node tests/e2e/reply-timeout.mjs && node tests/e2e/routine-run-lifetime.mjs && node tests/e2e/secrets-lifetime.mjs && node tests/e2e/sidebar-compact.mjs && node tests/e2e/transcript-scroll-lifetime.mjs"
  },
  "dependencies": {
    "dompurify": "^3.4.17",
    "exceljs": "^4.4.0",
    "framer-motion": "^12.23.12",
    "gifenc": "^1.0.3",
    "katex": "^0.18.9",
    "mediabunny": "^1.61.0",
    "mermaid": "^11.17.0",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.1.11",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.6.0",
    "@vitest/coverage-v8": "^4.1.10",
    "concurrently": "^9.2.5",
    "electron": "^37.2.6",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-security": "^4.2.0",
    "jsdom": "^30.0.1",
    "playwright-core": "^1.63.0",
    "tailwindcss": "^4.1.11",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^6.4.5",
    "vitest": "^4.1.10"
  },
  "description": "Hermes Desk — local Hermes agents on your Mac",
  "author": "DevvGwardo",
  "main": "electron/main.cjs",
  "build": {
    "appId": "com.devgwardo.hermesdesk",
    "productName": "Hermes Desk",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "!electron/**/*.test.*",
      "!**/node_modules/**",
      "!**/node_modules/@capacitor/**",
      "!**/node_modules/@esbuild/**",
      "!**/node_modules/esbuild/**",
      "!**/node_modules/@rollup/**",
      "!**/node_modules/rollup/**",
      "!**/node_modules/fsevents/**",
      "!**/{android,ios,.transforms}/**"
    ],
    "asarUnpack": [
      "**/*.node",
      "electron/local/mcp/shim/hermes-desk-mcp.cjs"
    ],
    "artifactName": "Hermes-Desk-${version}-${os}-${arch}.${ext}",
    "mac": {
      "target": [
        {
          "target": "dir",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.developer-tools",
      "identity": null,
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": false
    }
  }
}
